name: {{.ServiceName}}
port: {{.Port}}

{{- if .HasDB}}
databases:
  - name: {{.DBName}}
    driver: postgres
    url: "${DATABASE_URL}"
    pool:
      max_conns: 10
      min_conns: 2
{{- end}}
{{- if .HasNATS}}

nats:
  - name: primary
    url: "${NATS_URL}"
    streams:
{{- range .StreamNames}}
      - name: {{.}}
{{- end}}
{{- end}}
{{- if eq .AuthDriver "manual"}}

auth:
  enabled: true
  driver: manual
  secret: "${JWT_SECRET}"
  algorithm: HS256
  expiry: 3600
{{- end}}

entry:
{{- if eq .AuthDriver "manual"}}
  - type: rest
    method: POST
    path: /auth/login
    handler: login
{{- range .AuthFeatures}}
{{- if eq . "mfa"}}
  - type: rest
    method: POST
    path: /auth/mfa/enable
    handler: MFAEnable
    auth_modes: [jwt]
  - type: rest
    method: POST
    path: /auth/mfa/verify
    handler: MFAVerify
    auth_modes: [jwt]
{{- else if eq . "magic-link"}}
  - type: rest
    method: POST
    path: /auth/magic-link
    handler: MagicLinkSend
  - type: rest
    method: GET
    path: /auth/magic-link/verify
    handler: MagicLinkVerify
{{- else if eq . "sms"}}
  - type: rest
    method: POST
    path: /auth/sms/send
    handler: SMSSend
  - type: rest
    method: POST
    path: /auth/sms/verify
    handler: SMSVerify
{{- else if eq . "social"}}
  - type: rest
    method: GET
    path: /auth/:provider/login
    handler: SocialLogin
  - type: rest
    method: GET
    path: /auth/:provider/callback
    handler: SocialCallback
  - type: rest
    method: GET
    path: /auth/linked-accounts
    handler: LinkedAccounts
    auth_modes: [jwt]
  - type: rest
    method: POST
    path: /auth/link
    handler: LinkAccount
    auth_modes: [jwt]
  - type: rest
    method: DELETE
    path: /auth/linked-accounts/:id
    handler: UnlinkAccount
    auth_modes: [jwt]
{{- else if eq . "webauthn"}}
  - type: rest
    method: POST
    path: /auth/webauthn/register/begin
    handler: WebAuthnRegisterBegin
    auth_modes: [jwt]
  - type: rest
    method: POST
    path: /auth/webauthn/register/finish
    handler: WebAuthnRegisterFinish
    auth_modes: [jwt]
  - type: rest
    method: POST
    path: /auth/webauthn/login/begin
    handler: WebAuthnLoginBegin
  - type: rest
    method: POST
    path: /auth/webauthn/login/finish
    handler: WebAuthnLoginFinish
  - type: rest
    method: POST
    path: /auth/webauthn/login/manual/begin
    handler: WebAuthnManualLoginBegin
  - type: rest
    method: POST
    path: /auth/webauthn/login/manual/finish
    handler: WebAuthnManualLoginFinish
  - type: rest
    method: GET
    path: /auth/webauthn/credentials
    handler: WebAuthnCredentials
    auth_modes: [jwt]
  - type: rest
    method: DELETE
    path: /auth/webauthn/credentials/:id
    handler: WebAuthnDeleteCredential
    auth_modes: [jwt]
{{- else if eq . "oauth-server"}}
  - type: rest
    method: GET
    path: /oauth/authorize
    handler: OAuthAuthorize
    auth_modes: [jwt]
  - type: rest
    method: POST
    path: /oauth/token
    handler: OAuthToken
  - type: rest
    method: POST
    path: /oauth/introspect
    handler: OAuthIntrospect
  - type: rest
    method: POST
    path: /oauth/revoke
    handler: OAuthRevoke
  - type: rest
    method: GET
    path: /oauth/clients
    handler: OAuthClientsList
    auth_modes: [jwt]
  - type: rest
    method: POST
    path: /oauth/clients
    handler: OAuthClientsCreate
    auth_modes: [jwt]
  - type: rest
    method: DELETE
    path: /oauth/clients/:id
    handler: OAuthClientsDelete
    auth_modes: [jwt]
  - type: rest
    method: GET
    path: /.well-known/openid-configuration
    handler: OIDCDiscovery
  - type: rest
    method: GET
    path: /.well-known/jwks.json
    handler: OIDCJWKS
  - type: rest
    method: GET
    path: /userinfo
    handler: OIDCUserInfo
{{- end}}
{{- end}}
{{- end}}
{{- if .HasDB}}
  - type: crud
    model: {{.ModelName}}
    db: {{.DBName}}
    table: {{.DBTable}}
    resource: {{.ResourceName}}
    path: /{{.ResourceName}}
{{- end}}
{{- if .HasRest}}
{{- range .RestEndpoints}}
  - type: rest
    method: {{.Method}}
    path: {{.Path}}
    handler: {{.HandlerName}}
{{- end}}
{{- end}}
{{- if .GrpcEnabled}}
  - type: grpc
    service_name: {{if .GrpcServiceName}}{{.GrpcServiceName}}{{else}}{{.ModelName}}Service{{end}}
    model: {{.ModelName}}
{{- end}}
{{- if .HasNATS}}
{{- range .Consumers}}

exit:
  - name: {{.Durable}}
    subscribe:
      stream: {{.Stream}}
      subject: {{.Stream}}
    handler: {{.Handler}}
    max_concurrent: 10
    reply: false
{{- end}}
{{- end}}

server:
  host: "0.0.0.0"
{{- if .GrpcEnabled}}
  mode: micro
  grpc_server:
    listen_on: ":{{.GrpcPort}}"
    health: true
{{- end}}
  api_prefix: /api
  middleware:
    - path: "/api/*"
      apply:
        - logger
        - breaker
        - cors
